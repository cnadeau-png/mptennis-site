{
  // MPTennis static site plus a tiny Worker for /api/latest-video.
  // Cloudflare builds both the live site (main) and preview versions of every branch.
  "name": "mptennis",
  "compatibility_date": "2026-11-17",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
